:root {
  --bg: #090d16;
  --panel: #101827;
  --card: #172033;
  --soft: #202b42;
  --line: #2b3854;
  --text: #e5edf8;
  --muted: #93a4bd;
  --dim: #65748b;
  --accent: #38bdf8;
  --accent-2: #a78bfa;
  --danger: #fb7185;
  --ok: #34d399;
  --warn: #fbbf24;
  --radius: 16px;
  color-scheme: dark;
}
* { box-sizing: border-box; }
html, body { height: 100%; overflow: hidden; }
body { margin: 0; background: radial-gradient(circle at top left, #172554 0, transparent 34rem), var(--bg); color: var(--text); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
button, input, textarea, select { font: inherit; }
button { border: 0; }
.shell { height: 100vh; display: flex; flex-direction: column; }
.topbar { height: 72px; padding: 12px 18px; border-bottom: 1px solid var(--line); background: rgba(9, 13, 22, .86); backdrop-filter: blur(16px); display: flex; align-items: center; gap: 14px; position: sticky; top: 0; z-index: 20; }
.eyebrow { margin: 0 0 2px; color: var(--accent); font-size: 11px; text-transform: uppercase; letter-spacing: .12em; }
h1, h2, p { margin-top: 0; }
h1 { margin: 0; font-size: 22px; letter-spacing: -.04em; }
h2 { margin-bottom: 12px; font-size: 15px; }
.top-actions { margin-left: auto; display: flex; align-items: center; gap: 8px; }
.status { padding: 6px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font-size: 12px; }
.status.active { color: var(--ok); border-color: rgba(52, 211, 153, .4); background: rgba(52, 211, 153, .1); }
.layout { flex: 1; min-height: 0; height: calc(100vh - 72px); display: grid; grid-template-columns: 360px minmax(0, 1fr); overflow: hidden; }
.panel { border-right: 1px solid var(--line); background: rgba(16, 24, 39, .94); padding: 16px; overflow: auto; }
.card { background: rgba(23, 32, 51, .88); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px; margin-bottom: 14px; box-shadow: 0 16px 48px rgba(0,0,0,.18); }
.section-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.mode-tabs { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; padding: 4px; background: var(--soft); border-radius: 12px; }
.mode-tab { cursor: pointer; border-radius: 10px; padding: 9px; color: var(--muted); background: transparent; }
.mode-tab.active { color: #04111f; background: linear-gradient(135deg, var(--accent), #7dd3fc); font-weight: 800; }
.notice { margin: 10px 0 0; color: var(--warn); font-size: 12px; line-height: 1.6; }
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; color: var(--muted); font-size: 12px; }
.field input, .field textarea, .field select { width: 100%; border: 1px solid var(--line); border-radius: 11px; background: #0d1422; color: var(--text); padding: 10px 11px; outline: none; }
.field input:focus, .field textarea:focus, .field select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(56, 189, 248, .12); }
.grid { display: grid; gap: 10px; }
.grid.two { grid-template-columns: 1fr 1fr; }
.row { display: flex; gap: 8px; flex-wrap: wrap; }
.row.compact { flex-wrap: nowrap; }
.small-btn, .ghost-btn, .primary-btn, .danger-btn, .icon-btn { cursor: pointer; border-radius: 11px; padding: 9px 12px; color: var(--text); border: 1px solid var(--line); background: var(--soft); }
.small-btn { padding: 6px 10px; font-size: 12px; }
.ghost-btn:hover, .small-btn:hover, .icon-btn:hover { border-color: var(--accent); }
.primary-btn { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #08111f; font-weight: 800; border: 0; }
.danger-btn { background: rgba(251, 113, 133, .15); color: #fecdd3; border-color: rgba(251, 113, 133, .35); }
button:disabled { opacity: .45; cursor: not-allowed; }
.participants { display: flex; flex-direction: column; gap: 10px; }
.participant { display: grid; grid-template-columns: 12px 1fr; gap: 10px; padding: 12px; border: 1px solid var(--line); border-radius: 14px; background: #0d1422; cursor: pointer; }
.dot { width: 12px; height: 12px; margin-top: 4px; border-radius: 999px; }
.participant strong { display: block; margin-bottom: 3px; }
.meta, .caps, .model-results { color: var(--muted); font-size: 12px; line-height: 1.55; }
.caps span { display: inline-block; margin: 4px 4px 0 0; padding: 2px 7px; border-radius: 999px; background: rgba(56, 189, 248, .12); color: #bae6fd; }
.chat { min-width: 0; min-height: 0; height: 100%; display: flex; flex-direction: column; }
.messages { flex: 1; overflow: auto; padding: 22px; display: flex; flex-direction: column; gap: 16px; }
.welcome { margin: auto; max-width: 620px; text-align: center; color: var(--muted); }
.logo-mark { width: 72px; height: 72px; margin: 0 auto 18px; display: grid; place-items: center; border-radius: 22px; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #08111f; font-size: 34px; font-weight: 900; }
.message { display: grid; grid-template-columns: 38px minmax(0, 1fr); gap: 12px; max-width: 920px; }
.message.user { align-self: flex-end; grid-template-columns: minmax(0, 1fr) 38px; }
.avatar { width: 38px; height: 38px; border-radius: 14px; display: grid; place-items: center; font-weight: 900; color: white; }
.message.user .avatar { grid-column: 2; grid-row: 1; background: var(--accent) !important; color: #08111f; }
.bubble { border: 1px solid var(--line); background: rgba(23, 32, 51, .9); border-radius: 16px; padding: 12px 14px; line-height: 1.72; word-break: break-word; }
.message.user .bubble { background: rgba(56, 189, 248, .12); }
.markdown-body { white-space: normal; }
.markdown-body p { margin: 0 0 10px; }
.markdown-body p:last-child { margin-bottom: 0; }
.markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4, .markdown-body h5, .markdown-body h6 { margin: 12px 0 8px; line-height: 1.3; color: var(--text); }
.markdown-body h1 { font-size: 22px; }
.markdown-body h2 { font-size: 19px; }
.markdown-body h3 { font-size: 17px; }
.markdown-body h4, .markdown-body h5, .markdown-body h6 { font-size: 15px; }
.markdown-body ul, .markdown-body ol { margin: 8px 0 12px; padding-left: 22px; }
.markdown-body li { margin: 4px 0; }
.markdown-body blockquote { margin: 10px 0; padding: 8px 12px; border-left: 3px solid var(--accent); background: rgba(56, 189, 248, .08); color: var(--muted); border-radius: 8px; }
.markdown-body code { padding: 2px 5px; border: 1px solid var(--line); border-radius: 6px; background: #07101d; color: #bae6fd; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .92em; }
.markdown-body pre { margin: 10px 0; padding: 12px; overflow: auto; border: 1px solid var(--line); border-radius: 12px; background: #07101d; }
.markdown-body pre code { padding: 0; border: 0; background: transparent; color: #dbeafe; white-space: pre; }
.markdown-body a { color: #7dd3fc; text-decoration: none; }
.markdown-body a:hover { text-decoration: underline; }
.msg-head { display: flex; gap: 8px; align-items: center; margin-bottom: 6px; color: var(--muted); font-size: 12px; }
.divider { text-align: center; color: var(--dim); font-size: 12px; display: flex; align-items: center; gap: 12px; }
.divider::before, .divider::after { content: ""; height: 1px; flex: 1; background: var(--line); }
.error { color: #fecdd3; }
.file-preview { border-top: 1px solid var(--line); padding: 10px 18px; display: flex; gap: 8px; flex-wrap: wrap; background: rgba(16, 24, 39, .9); }
.file-chip { display: inline-flex; align-items: center; gap: 6px; padding: 6px 9px; border: 1px solid var(--line); border-radius: 999px; background: var(--soft); color: var(--muted); font-size: 12px; }
.file-chip button { padding: 0 4px; background: transparent; color: var(--danger); cursor: pointer; }
.hidden { display: none !important; }
.composer { flex-shrink: 0; border-top: 1px solid var(--line); display: flex; gap: 10px; padding: 14px 18px; background: rgba(9, 13, 22, .9); }
.composer input[type=text] { flex: 1; min-width: 0; border: 1px solid var(--line); border-radius: 14px; background: #0d1422; color: var(--text); padding: 0 14px; }
.dialog { width: min(720px, calc(100vw - 24px)); border: 1px solid var(--line); border-radius: 18px; padding: 0; background: var(--panel); color: var(--text); }
.dialog::backdrop { background: rgba(0,0,0,.7); backdrop-filter: blur(4px); }
.dialog-body { padding: 16px; }
.dialog-head, .dialog-actions, .panel-head { display: flex; align-items: center; gap: 10px; }
.dialog-head h2 { margin: 0; }
.dialog-head .icon-btn { margin-left: auto; }
.dialog-actions { margin-top: 8px; }
.spacer { flex: 1; }
.check { display: flex; align-items: center; gap: 8px; color: var(--muted); margin-top: 24px; }
.mobile-only { display: none; }
@media (max-width: 860px) {
  .layout { display: block; }
  .panel { position: fixed; inset: 0 auto 0 0; width: min(92vw, 360px); transform: translateX(-105%); transition: transform .2s ease; z-index: 40; }
  .panel.open { transform: translateX(0); }
  .mobile-only { display: inline-flex; }
  .panel-head { justify-content: space-between; margin-bottom: 12px; }
  .top-actions .ghost-btn { display: none; }
  .chat { max-height: calc(100vh - 72px); }
  .messages { padding: 16px; }
  .message { max-width: 100%; }
  .grid.two { grid-template-columns: 1fr; }
}
